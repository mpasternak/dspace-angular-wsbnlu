# Copy to .deploy-ui.env (git-ignored) and fill in. Read by scripts/deploy-ui.sh.
DEPLOY_HOST=repo.example.edu
DEPLOY_DIR=/opt/dspace-angular
DEPLOY_PM2_APP=dspace-angular
# Command for the root part; a wrapper that forwards a sudo-only agent key works too.
DEPLOY_SSH=ssh
DEPLOY_RSYNC_SSH=ssh
# An item page whose HTML must contain CHECK_GREP after the deploy; failure = automatic rollback.
CHECK_URL=https://repo.example.edu/items/00000000-0000-0000-0000-000000000000
CHECK_GREP='<meta name="citation_title"'
